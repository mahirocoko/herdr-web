{
  "name": "herdr-web-ui",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "description": "Browser version of the herdr terminal - live herdr workspaces, panes and agents in a web UI",
  "license": "Apache-2.0 AND MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahirocoko/herdr-web.git"
  },
  "scripts": {
    "dev": "bash scripts/bun-project.sh scripts/run-local.ts",
    "build": "bash scripts/bun-project.sh --bun vite build",
    "server": "bash scripts/bun-project.sh scripts/run-local.ts",
    "start": "bash scripts/bun-project.sh scripts/run-local.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "check": "bash scripts/bun-project.sh scripts/check.ts",
    "test": "bash scripts/bun-project.sh scripts/ci-tests.ts unit",
    "test:unit": "bash scripts/bun-project.sh scripts/ci-tests.ts unit",
    "test:integration": "bash scripts/bun-project.sh scripts/ci-tests.ts integration",
    "test:native": "bash scripts/bun-project.sh scripts/check.ts run bun scripts/fork-native-check.ts",
    "source:verify": "bash scripts/bun-project.sh scripts/verify-upstream.ts",
    "test:ui": "bash scripts/bun-project.sh scripts/check.ts browser",
    "generate:types": "bash scripts/bun-project.sh scripts/generate-protocol-types.ts",
    "generate:themes": "bash scripts/bun-project.sh scripts/generate-themes.ts",
    "build:remote": "bash scripts/bun-project.sh scripts/build-remote-bundle.ts",
    "build:site": "bash scripts/bun-project.sh scripts/build-site.ts",
    "test:ssh": "bash scripts/bun-project.sh scripts/ssh-integration.ts"
  },
  "dependencies": {
    "@legendapp/list": "3.3.5",
    "@lydell/node-pty": "1.1.0",
    "@pierre/diffs": "1.5.2",
    "@tanstack/highlight": "^1.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.1.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.49.1",
    "react-test-renderer": "19.3.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^6.0.3",
    "vite": "^8.3.4"
  },
  "patchedDependencies": {
    "@legendapp/list@3.3.5": "patches/@legendapp%2Flist@3.3.5.patch",
    "@xterm/xterm@5.5.0": "patches/@xterm%2Fxterm@5.5.0.patch"
  },
  "packageManager": "bun@1.4.2"
}
